# Backend Port
BACKEND_PORT=9818
# REQUIRED. Generate with: openssl rand -base64 48
JWT_SECRET=random_key

# Comma-separated list of allowed browser origins (CORS).
# Leave unset to allow any origin (fine for local development only).
# CORS_ORIGIN=https://meowdo.donusoft.com

# Frontend Port
FRONTEND_PORT=9819

# API Base URL for Frontend
VITE_API_BASE_URL=https://meowdo.donusoft.com/api/v1

# Database Configuration
# Use "postgres" (default) or "sqlite".
DB_DRIVER=postgres
# Required for PostgreSQL mode.
DATABASE_URL=postgres://random_user:random_password@localhost:5432/meowdo_db
# Used only in SQLite mode. The directory is created automatically.
SQLITE_PATH=./data/meowdo.sqlite
DB_NAME=meowdo_db
DB_USER=random_user
DB_PASSWORD=random_password
